{
  "name": "guardian-form",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs",
    "build": "npm run typecheck && node scripts/run-vite.mjs build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "node scripts/run-vite.mjs preview",
    "test:e2e": "playwright test --project=chromium-local",
    "test:e2e:chromium": "playwright test --project=chromium-local",
    "test:e2e:matrix": "playwright test --project=chromium-local --project=firefox-matrix --project=webkit-matrix",
    "test:e2e:responsive": "playwright test --project=responsive-chromium",
    "test:e2e:pdf": "playwright test --project=pdf-chromium",
    "test": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.77.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.53.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
